{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/(build|assets)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/(.*\\.(?:css|gif|ico|jpe?g|js|png|svg|txt|webp|woff2?))",
            "dest": "public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
