APP_NAME="Cooper Trading"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://coopera.razielcc.com

APP_CURRENCY=ETB
APP_CURRENCY_SYMBOL=Br
APP_VAT_RATE=15

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=env

BCRYPT_ROUNDS=12

LOG_CHANNEL=errorlog
LOG_LEVEL=warning

# Database — SQLite only. On Vercel the runtime copies database/database.sqlite
# (seeded at build time) into /tmp/database.sqlite on first hit.
DB_CONNECTION=sqlite
# DB_DATABASE=/tmp/database.sqlite

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=

# Mail — 'log' writes to PHP error_log (captured by Vercel). Switch to 'smtp'
# + fill credentials below when SMTP is ready.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="info@cooperatrading.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@cooperatrading.com

# Production SMTP (commented — leave MAIL_MAILER=log until SMTP is set up)
# MAIL_MAILER=smtp
# MAIL_HOST=mail.cooperatrading.com
# MAIL_PORT=587
# MAIL_USERNAME=info@cooperatrading.com
# MAIL_PASSWORD=your-cpanel-email-password
# MAIL_ENCRYPTION=tls

VITE_APP_NAME="${APP_NAME}"
